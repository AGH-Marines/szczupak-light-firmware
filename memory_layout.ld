RAM_START = 0x20000000;
RAM_SIZE = 144K;

BOOT_FLASH_START = 0x08000000;
BOOT_FLASH_SIZE = 16K;

APP_FLASH_START = 0x08004000;
APP_FLASH_SIZE = 110K;

METADATA_START = 0x0801F800;
METADATA_SIZE = 2K;

__ram_start__ = RAM_START;
__ram_end__ = RAM_START + RAM_SIZE;

__app_start__ = APP_FLASH_START;
__app_end__ = APP_FLASH_START + APP_FLASH_SIZE;

__metadata_start__ = METADATA_START;
__metadata_end__ = METADATA_START + METADATA_SIZE;